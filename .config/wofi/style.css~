window {
    margin: 0px;
    font-family:"Noto Serif CJK SC", "Noto Sans", sans-serif;
    font-size: 15px;
    font-weight: 500;
    background-color: #000000;
    opacity:0.8;
    border: 1.5px solid #c74a4a;
    border-radius: 20px;
    box-shadow: 0 4px 20px rgba(102, 204, 255, 0.3);
}

#input {
    margin: 8px;
    /*border: 1px solid rgba(102, 204, 255, 0.5);*/
    border-radius: 30px;
    background-color: transparent;
    color: #ffffff;
    padding: 10px;
}

#scroll {
    margin: 8px;
    border: none;
}

#entry {
    padding: 10px 14px;
    border-radius: 20px;
    color: #ffffff;
}

#entry:selected {
    background-color: #2e2e2e;
    color: #ffffff;
    font-weight: bold;
}

